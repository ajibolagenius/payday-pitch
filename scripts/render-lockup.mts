// Generates the drawn lockup assets (spec 0010 AC-6). The wordmark is traced
// from the vendored Melodrama variable woff2 instanced at weight 600, so the
// drawn asset matches the live text settings and regenerates rather than
// drifts. Run: pnpm brand:lockup
//
// Outputs (both generated; a hand edited copy is a review reject):
//   public/brand/lockup-horizontal.svg  standalone asset, literal hex like the masters
//   src/lib/brand-art.ts                color free geometry for email JSX (check:hex safe)
import { mkdir, readFile, writeFile } from "node:fs/promises"
import path from "node:path"

import { create as createFont } from "fontkit"
import wawoff2 from "wawoff2"

// --- pinned canvas (spec 0010 geometry) ---
const CANVAS_W = 736
const CANVAS_H = 160
const CHIP_BOX = 128
const CHIP_X = 0
const CHIP_Y = 16
const GAP = 28
const BASELINE_Y = 116
const CAP_HEIGHT = 72
const WEIGHT = 600
const TEXT = "Payday Pitch"
// tracking-tight, the live Wordmark setting, applied per letter advance
const TRACKING_EM = -0.025

// masters use literal hex; public/** is outside check:hex scope
const HEX = {
  chip: "#1C4534",
  dots: "#F0C75E",
  keeper: "#FFFDF8",
  word: "#241F17", // --ink, the default body text color the live wordmark inherits
}

// primary mark geometry, the 512 box canonical values mirrored from
// src/components/brand/geometry.ts (a public asset cannot import TS)
const MASTER_SIZE = 512
const CHIP_RX = 112
const DOTS: ReadonlyArray<readonly [number, number]> = [
  [136, 118], [256, 118], [376, 118],
  [172, 220], [256, 220], [340, 220],
  [100, 322], [206, 322], [306, 322], [412, 322],
]
const DOT_R = 23
const KEEPER: readonly [number, number, number] = [256, 436, 31]

// reduced tier, mirrored the same way for the email footer
const REDUCED_DOTS: ReadonlyArray<{ cx: number; cy: number }> = [
  { cx: 136, cy: 160 }, { cx: 256, cy: 160 }, { cx: 376, cy: 160 },
  { cx: 188, cy: 292 }, { cx: 324, cy: 292 },
]
const REDUCED_DOT_R = 32
const REDUCED_KEEPER = { cx: 256, cy: 424, r: 42 }

const FONT_PATH = path.resolve(import.meta.dirname, "../src/app/styles/fonts/melodrama-variable.woff2")
const OUT_SVG = path.resolve(import.meta.dirname, "../public/brand/lockup-horizontal.svg")
const OUT_MODULE = path.resolve(import.meta.dirname, "../src/lib/brand-art.ts")

// fontkit reads ttf tables directly but its woff2 support does not inflate
// the brotli glyf/loca, so decompress first, then instance the weight axis.
const woff2 = new Uint8Array(await readFile(FONT_PATH))
const ttf = Buffer.from(await wawoff2.decompress(woff2))
const font = createFont(ttf)
if (!("getVariation" in font) || !font.variationAxes?.wght) {
  throw new Error("melodrama-variable.woff2 is not a variable font fontkit can instance")
}
const instance = font.getVariation({ wght: WEIGHT })

const unitsPerEm: number = instance.unitsPerEm
const capHeight: number = instance.capHeight ?? instance.ascender
const scale = CAP_HEIGHT / capHeight
// One em at this scale is unitsPerEm font units, so the em in px is
// unitsPerEm * scale. tracking-tight is a fraction of that em.
const fontSizePx = unitsPerEm * scale
const tracking = TRACKING_EM * fontSizePx

// --- trace the wordmark (kerning and spaces come from fontkit's layout) ---
type Glyph = { x: number; y: number; sx: number; sy: number; d: string }
const glyphs: Glyph[] = []
let penX = CHIP_X + CHIP_BOX + GAP
for (const pos of instance.layout(TEXT).glyphs) {
  const glyph = instance.getGlyph(pos.id, pos.name)
  glyphs.push({
    x: penX,
    y: BASELINE_Y,
    sx: scale,
    sy: -scale,
    d: contourPaths(glyph.path),
  })
  penX += pos.advanceWidth * scale + tracking
}

// fontkit toSVG() emits absolute M/L/C/Z commands, directly usable in a path
// whose translate carries the pen position.
function contourPaths(p: { toSVG(): string }): string {
  return p.toSVG()
}

const lastAdvance = glyphs.length ? penX : 0
if (lastAdvance > CANVAS_W) {
  console.warn(`wordmark reaches ${lastAdvance.toFixed(1)}px on a ${CANVAS_W}px canvas, check the pin`)
}

// --- assemble the SVG ---
const chipScale = CHIP_BOX / MASTER_SIZE
const dotEls = DOTS.map(([cx, cy]) => `    <circle cx="${cx}" cy="${cy}" r="${DOT_R}"/>`).join("\n")
const glyphEls = glyphs
  .map(
    (g) =>
      `    <path transform="translate(${round(g.x)} ${round(g.y)}) scale(${round(g.sx)} ${round(g.sy)})" d="${g.d}"/>`,
  )
  .join("\n")

const svg = `<svg width="${CANVAS_W}" height="${CANVAS_H}" viewBox="0 0 ${CANVAS_W} ${CANVAS_H}" xmlns="http://www.w3.org/2000/svg">
  <!-- generated by scripts/render-lockup.mts, do not hand edit -->
  <g transform="translate(${CHIP_X} ${CHIP_Y}) scale(${chipScale})">
    <rect width="${MASTER_SIZE}" height="${MASTER_SIZE}" rx="${CHIP_RX}" fill="${HEX.chip}"/>
    <g fill="${HEX.dots}">
${dotEls}
    </g>
    <circle cx="${KEEPER[0]}" cy="${KEEPER[1]}" r="${KEEPER[2]}" fill="${HEX.keeper}"/>
  </g>
  <g fill="${HEX.word}">
${glyphEls}
  </g>
</svg>
`

// --- email safe art module (constants only, no color) ---
const moduleText = `// GENERATED by scripts/render-lockup.mts (spec 0010 AC-6). Do not hand edit;
// run pnpm brand:lockup. Color free geometry so email JSX can compose the
// lockup and marks from BRAND palette constants (pnpm check:hex stays clean).

export const LOCKUP_GLYPHS: ReadonlyArray<{
  readonly x: number
  readonly y: number
  readonly sx: number
  readonly sy: number
  readonly d: string
}> = [
${glyphs
  .map((g) => `  { x: ${round(g.x)}, y: ${round(g.y)}, sx: ${round(g.sx)}, sy: ${round(g.sy)}, d: "${g.d}" },`)
  .join("\n")}
]

export const PRIMARY_CHIP = {
  size: ${MASTER_SIZE},
  rx: ${CHIP_RX},
  dots: ${JSON.stringify(DOTS.map(([cx, cy]) => ({ cx, cy })))},
  dotR: ${DOT_R},
  keeper: { cx: ${KEEPER[0]}, cy: ${KEEPER[1]}, r: ${KEEPER[2]} },
} as const

/** Where the chip sits on the 736x160 lockup canvas. */
export const LOCKUP_CHIP = { x: ${CHIP_X}, y: ${CHIP_Y}, scale: ${chipScale} } as const

export const REDUCED_CHIP = {
  size: ${MASTER_SIZE},
  rx: ${CHIP_RX},
  dots: ${JSON.stringify(REDUCED_DOTS)},
  dotR: ${REDUCED_DOT_R},
  keeper: ${JSON.stringify(REDUCED_KEEPER)},
} as const
`

// Five decimals: two would round the 0.102857 glyph scale to 0.1 and drop the
// pinned 72 px cap height to 70.
function round(n: number): number {
  return Math.round(n * 100000) / 100000
}

await mkdir(path.dirname(OUT_SVG), { recursive: true })
await writeFile(OUT_SVG, svg)
await writeFile(OUT_MODULE, moduleText)
console.warn(`wrote ${path.relative(process.cwd(), OUT_SVG)} and ${path.relative(process.cwd(), OUT_MODULE)}`)
